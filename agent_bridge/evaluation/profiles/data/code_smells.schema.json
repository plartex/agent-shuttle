{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CodeSmellsKnowledgeBase",
  "description": "Схема базы знаний о запахах кода (Code Smells) с иерархией категорий, определениями, метриками и примерами рефакторинга.",
  "type": "object",
  "required": [
    "meta",
    "categories",
    "smells"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "title",
        "version",
        "updated_at",
        "description",
        "total_categories",
        "total_subcategories",
        "total_smells"
      ],
      "properties": {
        "title": { "type": "string" },
        "version": { "type": "string" },
        "updated_at": { "type": "string" },
        "description": { "type": "string" },
        "total_categories": { "type": "integer", "minimum": 1 },
        "total_subcategories": { "type": "integer", "minimum": 1 },
        "total_smells": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "name_en",
          "description",
          "subcategories"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "name": { "type": "string", "minLength": 2 },
          "name_en": { "type": "string", "minLength": 2 },
          "description": { "type": "string", "minLength": 10 },
          "subcategories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "name_en",
                "description"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$"
                },
                "name": { "type": "string", "minLength": 2 },
                "name_en": { "type": "string", "minLength": 2 },
                "description": { "type": "string", "minLength": 10 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "smells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "name_en",
          "category_id",
          "subcategory_id",
          "level",
          "severity",
          "summary",
          "definition",
          "symptoms",
          "root_causes",
          "impact",
          "detection_metrics",
          "refactoring_techniques",
          "bad_example",
          "good_example",
          "related_smells",
          "tags"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "name": { "type": "string", "minLength": 2 },
          "name_en": { "type": "string", "minLength": 2 },
          "category_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "subcategory_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "level": {
            "type": "string",
            "enum": [
              "method",
              "class",
              "module",
              "architecture",
              "database",
              "concurrency",
              "test",
              "component",
              "security"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "summary": { "type": "string", "minLength": 10 },
          "definition": { "type": "string", "minLength": 20 },
          "symptoms": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 5 }
          },
          "root_causes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 5 }
          },
          "impact": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 5 }
          },
          "detection_metrics": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "refactoring_techniques": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "description"],
              "properties": {
                "name": { "type": "string", "minLength": 2 },
                "description": { "type": "string", "minLength": 10 }
              },
              "additionalProperties": false
            }
          },
          "bad_example": {
            "type": "object",
            "required": ["language", "code", "explanation"],
            "properties": {
              "language": { "type": "string", "minLength": 1 },
              "code": { "type": "string", "minLength": 10 },
              "explanation": { "type": "string", "minLength": 10 }
            },
            "additionalProperties": false
          },
          "good_example": {
            "type": "object",
            "required": ["language", "code", "explanation"],
            "properties": {
              "language": { "type": "string", "minLength": 1 },
              "code": { "type": "string", "minLength": 10 },
              "explanation": { "type": "string", "minLength": 10 }
            },
            "additionalProperties": false
          },
          "related_smells": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            }
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 2 }
          },
          "refactoring_guru_url": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
